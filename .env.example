# Postgres connection string. With the bundled docker-compose:
# docker compose up -d
# DATABASE_URL=postgres://konnect:konnect@localhost:5432/konnecterp
DATABASE_URL=postgres://konnect:konnect@localhost:5432/konnecterp

# Long random string used to sign admin session cookies.
JWT_SECRET=change-me-to-a-long-random-string

# Single admin account (MVP auth). Generate ADMIN_PASSWORD_HASH with:
# node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Ports
API_PORT=5001
CLIENT_ORIGIN=http://localhost:5000
