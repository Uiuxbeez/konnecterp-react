# Postgres connection string. With the bundled docker-compose:
# docker compose up -d
# DATABASE_URL=postgres://konnect:konnect@localhost:5432/konnecterp
# In production (e.g. Railway), use your Neon connection string instead.
DATABASE_URL=postgres://konnect:konnect@localhost:5432/konnecterp

# Long random string used to sign admin session cookies.
JWT_SECRET=change-me-to-a-long-random-string

# Single admin account (MVP auth). Generate ADMIN_PASSWORD_HASH with:
# node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Local dev only — Railway (or any PaaS) injects PORT automatically, don't set it there.
API_PORT=5001

# The frontend origin(s) allowed to call this API with credentials (comma-separated).
# Local dev: http://localhost:5000
# Production: your Cloudflare Pages URL(s), e.g.
#   https://konnecterp-react.pages.dev,https://your-custom-domain.com
CLIENT_ORIGIN=http://localhost:5000

# Set to "production" on Railway — switches cookies to SameSite=None; Secure,
# which is required for the cross-domain frontend (Cloudflare Pages) to send the
# admin session cookie to this API.
NODE_ENV=development

# Optional: overrides the base URL used when generating uploaded-image URLs.
# Only needed if request-based detection (protocol + host) is unreliable behind
# your proxy. Example: https://your-api.up.railway.app
PUBLIC_API_URL=

# Set in the Cloudflare Pages build environment (NOT needed for local dev, where
# the Vite dev server proxies /api to localhost — leave unset locally).
# Example: https://your-api.up.railway.app
VITE_API_URL=

# Optional SMTP settings for sending form submissions as email.
# Configure these on the VPS/Godaddy server. If omitted, leads are still saved
# in the admin panel, but email delivery is skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Konnect ERP Website <no-reply@konnectbi.com>"
FORM_DEFAULT_RECIPIENT=sales@konnectbi.com
FORM_CAREER_RECIPIENT=hr@konnectbi.com
